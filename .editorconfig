dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.literal_should_be_literal.severity = warning
dotnet_naming_rule.literal_should_be_literal.symbols = literal
dotnet_naming_rule.literal_should_be_literal.style = literal

